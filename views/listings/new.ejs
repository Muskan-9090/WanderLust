<% layout('/layouts/boilerplate') %>
<body>
    <div class="row">
        <div class="col-8 offset-2">
            <br>
            <h2>Create a new listing</h2>
            <form method="post" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="listing[title]" class="form-label">Title</label>
                    <input name="listing[title]" id="listing[title]" placeholder="Add a catchy title" type="text" class="form-control" required>
                    <div class="invalid-feedback">Title should be valid</div>
                </div>
                <div class="mb-3">
                    <label for="listing[description]" class="form-label">Description</label>
                    <textarea name="listing[description]" id="listing[description]" placeholder="enter description here" type="text" rows="5" cols="30" class="form-control" required></textarea>
                    <div class="invalid-feedback">Description should be valid</div>
                </div>
                <div class="mb-3">
                    <label for="listing[image]" class="form-label">Upload Image</label>
                    <input name="listing[image]" id="listing[image]" type="file" class="form-control" required>
                    <div class="invalid-feedback">Upload a valid image</div>
                </div>
                <div class="mb-3">
                    <label for="listing[category]" class="form-label">Category</label>
                    <select class="form-select" id="listing[category]" name="listing[category]" aria-label="Default select example" required>
                        <option disabled selected>Select category</option>
                        <option value="Trending">Trending</option>
                        <option value="Mountains">Mountains</option>
                        <option value="Beaches">Beaches</option>
                        <option value="Camping">Camping</option>
                        <option value="Spiritual">Spiritual</option>
                        <option value="Lakeside">Lakeside</option>
                        <option value="Historic">Historic</option>
                        <option value="Luxury">Luxury</option>
                        <option value="Desert">Desert</option>
                        <option value="Forest">Forest</option>
                        <option value="Snowy">Snowy</option>
                        <option value="Wildlife">Wildlife</option>  
                    </select>
                    <div class="invalid-feedback">Please select a category</div>
                </div>
                <div class="row">
                    <div class="mb-3 col-md-4">
                        <label for="listing[price]" class="form-label">Price</label>
                        <input name="listing[price]" id="listing[price]" placeholder="1200" type="number" class="form-control" required>
                        <div class="invalid-feedback">Price should be valid</div>
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="listing[country]" class="form-label">Country</label>
                        <input name="listing[country]" id="listing[country]" placeholder="India" type="text" class="form-control" required>
                        <div class="invalid-feedback">Country name should be valid</div>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="listing[location]" class="form-label">Location</label>
                    <input name="listing[location]" id="listing[location]" placeholder="Jind,Haryana" type="text" class="form-control" required>
                    <div class="invalid-feedback">Location should be valid</div>
                </div>
                <button class="btn btn-dark add-btn">Create</button>
                <br><br>
            </form>
        </div>
    </div>
</body>