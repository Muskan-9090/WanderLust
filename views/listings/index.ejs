<% layout('/layouts/boilerplate') %>
<body>
    <!-- Filters for Large Screens -->
    <div id="filters" class="mt-3 mb-3 d-none d-md-flex flex-wrap">
    <div class="filter <%= selectedCategory === 'Trending' ? 'active' : '' %>">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>
    <div class="filter <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </div>
    <div class="filter <%= selectedCategory === 'Beaches' ? 'active' : '' %>">
        <div><i class="fa-solid fa-umbrella-beach"></i></div>
        <p>Beaches</p>
    </div>
    <div class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div>
    <div class="filter <%= selectedCategory === 'Spiritual' ? 'active' : '' %>">
        <div><i class="fa-solid fa-place-of-worship"></i></div>
        <p>Spiritual</p>
    </div>
    <div class="filter <%= selectedCategory === 'Lakeside' ? 'active' : '' %>">
        <div><i class="fa-solid fa-water"></i></div>
        <p>Lakeside</p>
    </div>
    <div class="filter <%= selectedCategory === 'Historic' ? 'active' : '' %>">
        <div><i class="fa-solid fa-landmark"></i></div>
        <p>Historic</p>
    </div>
    <div class="filter <%= selectedCategory === 'Luxury' ? 'active' : '' %>">
        <div><i class="fa-solid fa-gem"></i></div>
        <p>Luxury</p>
    </div>
    <div class="filter <%= selectedCategory === 'Desert' ? 'active' : '' %>">
        <div><i class="fa-solid fa-sun"></i></div>
        <p>Desert</p>
    </div>
    <div class="filter <%= selectedCategory === 'Forest' ? 'active' : '' %>">
        <div><i class="fa-solid fa-tree"></i></div>
        <p>Forest</p>
    </div>
    <div class="filter <%= selectedCategory === 'Snowy' ? 'active' : '' %>">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Snowy</p>
    </div>
    <div class="filter <%= selectedCategory === 'Wildlife' ? 'active' : '' %>">
        <div><i class="fa-solid fa-paw"></i></div>
        <p>Wildlife</p>
    </div>
    <div class="tax-toggle ms-auto">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input toggle-btn" type="checkbox" role="switch" id="toggle-btn">
            <label class="form-check-label" for="toggle-btn" style="font-size:0.8rem;">Display Total with taxes</label>
        </div>
    </div>
    </div>

    <!-- Dropdown for Small & Medium Screens -->
    <div class="d-md-none mt-3 mb-3">
    <div class="d-flex gap-2">
        <button class="btn filter-btn btn-dark w-50 d-flex justify-content-between align-items-center shadow mr-2" data-bs-toggle="collapse" data-bs-target="#filtersDropdown">
            <span class="fw-semibold">Categories</span>
            <i class="fa-solid fa-chevron-down"></i>
        </button>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input toggle-btn" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                <label class="form-check-label" for="flexSwitchCheckDefault" style="font-size:0.8rem;">Display Total with taxes</label>
            </div>
        </div>
    </div>
    <div class="collapse mt-1 bg-light p-3 rounded shadow" id="filtersDropdown">
        <div class="d-flex flex-column">
            <div class="filter <%= selectedCategory === 'Trending' ? 'active' : '' %>">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
            <div class="filter <%= selectedCategory === 'Mountains' ? 'active' : '' %>">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
            <div class="filter <%= selectedCategory === 'Beaches' ? 'active' : '' %>">
                <div><i class="fa-solid fa-umbrella-beach"></i></div>
                <p>Beaches</p>
            </div>
            <div class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </div>
            <div class="filter <%= selectedCategory === 'Spiritual' ? 'active' : '' %>">
                <div><i class="fa-solid fa-place-of-worship"></i></div>
                <p>Spiritual</p>
            </div>
            <div class="filter <%= selectedCategory === 'Lakeside' ? 'active' : '' %>">
                <div><i class="fa-solid fa-water"></i></div>
                <p>Lakeside</p>
            </div>
            <div class="filter <%= selectedCategory === 'Historic' ? 'active' : '' %>">
                <div><i class="fa-solid fa-landmark"></i></div>
                <p>Historic</p>
            </div>
            <div class="filter <%= selectedCategory === 'Luxury' ? 'active' : '' %>">
                <div><i class="fa-solid fa-gem"></i></div>
                <p>Luxury</p>
            </div>
            <div class="filter <%= selectedCategory === 'Desert' ? 'active' : '' %>">
                <div><i class="fa-solid fa-sun"></i></div>
                <p>Desert</p>
            </div>
            <div class="filter <%= selectedCategory === 'Forest' ? 'active' : '' %>">
                <div><i class="fa-solid fa-tree"></i></div>
                <p>Forest</p>
            </div>
            <div class="filter <%= selectedCategory === 'Snowy' ? 'active' : '' %>">
                <div><i class="fa-solid fa-snowflake"></i></div>
                <p>Snowy</p>
            </div>
            <div class="filter <%= selectedCategory === 'Wildlife' ? 'active' : '' %>">
                <div><i class="fa-solid fa-paw"></i></div>
                <p>Wildlife</p>
            </div>
        </div>
    </div>
    </div>
    <% if(allListings.length === 0){ %>
        <h3 style="color:#fe424d;">No results found.Try exploring something else!</h3>
    <% } %>
    <% if(allListings.length > 0){ %>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-2">
            <% for(let listing of allListings){ %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col listing-card">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height:20rem; margin-bottom:5px;">
                        <div class="card-img-overlay"></div>
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.location%>, <%= listing.country%></b><br>
                                <%= listing.title %><br>
                                &#8377 <%= listing.price.toLocaleString("en-in") %> / night
                                <i class="tax-info">+&nbsp;18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>
    <% } %>
</body>